{
  "$schema": "../../../schemas/tool.schema.json",
  "id": "cbonsai",
  "name": "cbonsai",
  "category": "tool",
  "summary": "Procedural bonsai tree grown in the terminal (live, infinite or screensaver mode). Colors are four xterm-256 indices, so low indices follow the terminal palette. No Windows build.",
  "homepage": "https://gitlab.com/jallbrit/cbonsai",
  "docs": "https://gitlab.com/jallbrit/cbonsai#usage",
  "license": "GPL-3.0-or-later",
  "configFormat": "none (command-line flags only)",
  "os": {
    "windows": {
      "supported": false,
      "notes": "ncurses program with no Windows build or package. For a Windows pane use rusty-rain or pipes-rs."
    },
    "macos": {
      "supported": true,
      "install": [{ "manager": "brew", "id": "cbonsai", "notes": "1.4.2." }],
      "detect": ["cbonsai", "--version"],
      "config": []
    },
    "linux": {
      "supported": true,
      "install": [
        { "manager": "apt", "id": "cbonsai", "notes": "Debian 13 and Ubuntu 24.04: 1.3.1 (older than the 1.4.2 README the recipes follow; check `cbonsai --help`)." },
        { "manager": "dnf", "id": "cbonsai", "notes": "Fedora: 1.3.1." },
        { "manager": "aur", "id": "cbonsai", "notes": "Arch: AUR only (1.4.2)." }
      ],
      "detect": ["cbonsai", "--version"],
      "config": []
    }
  },
  "capabilities": {
    "install-init": { "support": "yes", "recipe": "recipes/install-init.md" },
    "theme": { "support": "yes", "recipe": "recipes/theme.md", "notes": "-k dark-leaves,dark-wood,light-leaves,light-wood as color indices 0-255." },
    "config": { "support": "yes", "recipe": "recipes/config.md", "notes": "Flags only: live/infinite/screensaver, growth speed, life, branching, geometry, leaves." }
  },
  "verified": { "date": "2026-11-23", "version": "1.4.2", "how": "docs" },
  "sources": [
    "https://gitlab.com/jallbrit/cbonsai/-/blob/master/README.md",
    "https://formulae.brew.sh/formula/cbonsai",
    "https://packages.debian.org/trixie/cbonsai",
    "https://aur.archlinux.org/packages/cbonsai",
    "https://repology.org/project/cbonsai/versions"
  ]
}
