{
  "$schema": "../../schemas/look.schema.json",
  "name": "quiet",
  "description": "Calm, cool dark look that works the same on Windows, macOS and Linux: slate background, soft text, one steel-blue accent, muted pastel ANSI colors, no background image, one-line prompt.",
  "mood": ["dark", "cool", "calm", "minimal", "fast"],
  "palette": {
    "source": "quiet (hand-tuned)",
    "background": "#16181D",
    "foreground": "#D5D8DE",
    "cursor": "#8FB3C9",
    "selectionBackground": "#2F3A47",
    "accent": "#8FB3C9",
    "ansi": {
      "black": "#3A3F4A", "red": "#D47E7E", "green": "#9DBF8F", "yellow": "#D9BE85",
      "blue": "#82A8C9", "magenta": "#B596C4", "cyan": "#82BDB8", "white": "#C5C9D1",
      "brightBlack": "#6B7280", "brightRed": "#E39A9A", "brightGreen": "#B3D1A6", "brightYellow": "#E6D09E",
      "brightBlue": "#9DBDDB", "brightMagenta": "#C9AED6", "brightCyan": "#9DD0CB", "brightWhite": "#EEF0F3"
    }
  },
  "font": {
    "family": "JetBrains Mono",
    "fallback": ["Symbols Nerd Font Mono"],
    "size": 12.5,
    "weight": "normal",
    "ligatures": true,
    "lineHeight": 1.15
  },
  "window": {
    "opacity": 1,
    "blur": false,
    "padding": [14, 18, 10, 18],
    "cursorShape": "bar",
    "tabs": "auto",
    "titlebar": "integrated",
    "scrollbar": "hidden",
    "columns": 140,
    "rows": 38,
    "animations": false
  },
  "layout": { "multiplexer": "native", "quake": false },
  "prompt": {
    "engine": "starship",
    "lines": 1,
    "style": "plain",
    "segments": ["path", "git", "duration", "status", "runtimes"],
    "transient": false
  },
  "shells": [
    { "id": "bash", "default": true },
    { "id": "zsh" },
    { "id": "powershell" }
  ],
  "tools": [],
  "budget": { "shellStartMs": 500, "keystrokeMs": 0 },
  "targets": {
    "windows": { "terminal": "wezterm", "shells": ["powershell", "bash"] },
    "macos": { "terminal": "wezterm", "shells": ["zsh"] },
    "linux": { "terminal": "wezterm", "shells": ["bash"] }
  }
}
