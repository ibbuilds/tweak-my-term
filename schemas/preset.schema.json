{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preset.schema.json",
  "title": "Preset manifest",
  "description": "A tested look: the look spec plus the exact files, installs and checks per OS.",
  "type": "object",
  "required": ["name", "look", "os"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "look": { "type": "string" },
    "screenshots": { "type": "array", "items": { "type": "string" } },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windows": { "$ref": "#/$defs/osPlan" },
        "macos": { "$ref": "#/$defs/osPlan" },
        "linux": { "$ref": "#/$defs/osPlan" }
      }
    }
  },
  "$defs": {
    "osPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "verified": { "type": "string", "description": "machine-verified date, or 'docs' if only checked against docs." },
        "requires": { "type": "array", "items": { "type": "string" }, "description": "Catalog tool ids that must be installed." },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "from", "to"],
            "properties": {
              "kind": { "enum": ["write", "block", "merge-json"] },
              "from": { "type": "string" },
              "to": { "type": "string", "description": "Target with tokens: ~, {wt-settings}, {ps-profile}, {appdata}, {localappdata}, {xdg-config}." }
            }
          }
        },
        "installs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manager", "id"],
            "properties": { "manager": { "type": "string" }, "id": { "type": "string" }, "tool": { "type": "string" } }
          }
        },
        "fonts": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
      }
    }
  }
}
