#!/bin/sh
# tweak-my-term CLI shim (macOS, Linux, Git Bash)
if ! command -v node >/dev/null 2>&1; then
  echo "tmt needs Node.js 20 or newer. Install it: macOS 'brew install node', Debian/Ubuntu 'sudo apt-get install nodejs', Fedora 'sudo dnf install nodejs', Arch 'sudo pacman -S nodejs', Windows 'winget install OpenJS.NodeJS.LTS'." >&2
  exit 127
fi
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec node "$here/../engine/cli.js" "$@"
