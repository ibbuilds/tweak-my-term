// gruvbox-cozy (tmt)
theme "gruvbox-cozy"
default_shell "fish"
default_layout "gruvbox-cozy"
pane_frames true
show_startup_tips false
show_release_notes false
mouse_mode true
copy_on_select true
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}
themes {
    gruvbox-cozy {
        text_unselected { base 235 219 178; background 40 40 40; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 184 187 38; emphasis_3 211 134 155; }
        text_selected { base 235 219 178; background 80 73 69; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 184 187 38; emphasis_3 211 134 155; }
        ribbon_selected { base 40 40 40; background 254 128 25; emphasis_0 204 36 29; emphasis_1 250 189 47; emphasis_2 177 98 134; emphasis_3 69 133 136; }
        ribbon_unselected { base 40 40 40; background 168 153 132; emphasis_0 204 36 29; emphasis_1 146 131 116; emphasis_2 69 133 136; emphasis_3 177 98 134; }
        ribbon_hover { base 40 40 40; background 235 219 178; emphasis_0 204 36 29; emphasis_1 146 131 116; emphasis_2 69 133 136; emphasis_3 177 98 134; }
        table_title { base 254 128 25; background 40 40 40; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 184 187 38; emphasis_3 211 134 155; }
        table_cell_selected { base 235 219 178; background 80 73 69; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 184 187 38; emphasis_3 211 134 155; }
        table_cell_unselected { base 235 219 178; background 40 40 40; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 184 187 38; emphasis_3 211 134 155; }
        list_selected { base 235 219 178; background 80 73 69; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 184 187 38; emphasis_3 211 134 155; }
        list_unselected { base 235 219 178; background 40 40 40; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 184 187 38; emphasis_3 211 134 155; }
        frame_selected { base 254 128 25; background 0; emphasis_0 250 189 47; emphasis_1 142 192 124; emphasis_2 211 134 155; emphasis_3 211 134 155; }
        frame_highlight { base 250 189 47; background 0; emphasis_0 211 134 155; emphasis_1 250 189 47; emphasis_2 250 189 47; emphasis_3 250 189 47; }
        exit_code_success { base 184 187 38; background 0; emphasis_0 142 192 124; emphasis_1 0 0 0; emphasis_2 211 134 155; emphasis_3 146 131 116; }
        exit_code_error { base 251 73 52; background 0; emphasis_0 250 189 47; emphasis_1 250 189 47; emphasis_2 211 134 155; emphasis_3 142 192 124; }
        multiplayer_user_colors {
            player_1 211 134 155
            player_2 146 131 116
            player_3 184 187 38
            player_4 250 189 47
            player_5 142 192 124
            player_6 250 189 47
            player_7 251 73 52
            player_8 211 134 155
            player_9 184 187 38
            player_10 251 73 52
        }
    }
}
