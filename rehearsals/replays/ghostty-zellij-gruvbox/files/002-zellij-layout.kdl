// gruvbox-cozy workspace: editor | file manager over shell
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="home" focus=true {
        pane split_direction="vertical" {
            pane name="editor" size="62%" focus=true command="hx" {
                args "."
            }
            pane split_direction="horizontal" size="38%" {
                pane name="files" size="58%" command="yazi"
                pane name="shell" size="42%"
            }
        }
    }
}
