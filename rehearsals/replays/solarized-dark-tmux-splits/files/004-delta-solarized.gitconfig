[delta]
    dark = true
    syntax-theme = Solarized (dark)
    line-numbers = true
    minus-style = syntax "#1c3a3a"
    minus-emph-style = syntax "#5a3a36"
    plus-style = syntax "#0a3a2f"
    plus-emph-style = syntax "#2f4a2a"
    line-numbers-minus-style = "#dc322f"
    line-numbers-plus-style = "#859900"
    line-numbers-zero-style = "#586e75"
    hunk-header-decoration-style = "#586e75" box
    file-style = bold "#93a1a1"
