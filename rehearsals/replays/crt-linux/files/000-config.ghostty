background = #0A0600
foreground = #FFB000
cursor-color = #FFC940
selection-background = #4A3000
palette = 0=#1A1000
palette = 1=#E0602A
palette = 2=#C9A227
palette = 3=#FFB000
palette = 4=#B8862B
palette = 5=#D9803A
palette = 6=#E6B655
palette = 7=#CC9A3C
palette = 8=#7A5A1A
palette = 9=#FF7F3F
palette = 10=#E8C547
palette = 11=#FFCC33
palette = 12=#D9A441
palette = 13=#FF9F55
palette = 14=#FFD27A
palette = 15=#FFE2A8
font-family = "Terminess Nerd Font Mono"
font-size = 14
font-feature = -liga
adjust-cell-height = 10%
cursor-style = block
cursor-style-blink = false
window-padding-x = 28,28
window-padding-y = 20,20
window-padding-balance = true
window-padding-color = extend
window-decoration = false
gtk-tabs-location = hidden
custom-shader = ~/.config/ghostty/shaders/amber-crt.glsl
custom-shader-animation = false
